{
  "name": "@deniai/openclaw-flixa",
  "version": "0.3.0",
  "description": "Run Flixa Ship as an OpenClaw CLI backend.",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "prebuild": "npm run sync-version",
    "build": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "openclaw": ">=2026.5.17",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": ">=2026.5.17"
    }
  }
}
